<Window x:Class="PLCInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PLCInterface"
        mc:Ignorable="d"
        Title="PLC Interface" Width="270" Height="250" >
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Background="#FF333333">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Text="*Check admin mode if something is wrong." Foreground="white" />
            <GroupBox x:Name="groupBox" Header="Command" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,25,0,0"  Width="220" Height="60" Foreground="white" />
            <Button x:Name="button" Content="Start Service" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,50,0,0"  Width="80" Command="{Binding StartInterfaceCommand}" Background="{Binding StartPressedColor}"/>
            <Button x:Name="button1" Content="Stop Service" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="135,50,0,0" Width="80" Command="{Binding StopInterfaceCommand}" Background="{Binding StopPressedColor}"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,15,0,0" Width ="200" Text="PLC Connection Status" Foreground="white" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,15,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding PlcStatusColor}" />
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,45,0,0" Width ="200" Text="UI Connection Status" Foreground="white" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="180,45,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor}" />
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,15,0,0" Width ="200" Text="{Binding InfoMessage}" Foreground="white" />
        </Grid>
    </Grid>
</Window>

    