<Window x:Class="PLCInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PLCInterface"
        mc:Ignorable="d"
        Title="PLC Interface" Width="280" Height="270" >
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Background="#FF333333">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="37*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="115"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="4">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,2,0,0" Text="{Binding MainTitle}" Foreground="white" />
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,24,0,0" Text="*Check admin mode if something is wrong." Foreground="white" />
            <GroupBox x:Name="groupBox" Header="Command" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,39,0,0"  Width="220" Height="60" Foreground="white" />
            <Button x:Name="button" Content="Start Service" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,64,0,0"  Width="80" Command="{Binding StartInterfaceCommand}" Background="{Binding StartPressedColor}"/>
            <Button x:Name="button1" Content="Stop Service" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="135,64,0,0" Width="80" Command="{Binding StopInterfaceCommand}" Background="{Binding StopPressedColor}"/>
            <Button x:Name="button2" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,64,0,0" Width="20" Command="{Binding UsbTesterButtonCommand}" Background="DarkSeaGreen" Visibility="{Binding UsbTesterButtonVisible}"/>
            <Button x:Name="button3" Content="" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,64,0,0" Width="20" Command="{Binding ManualTriggerButtonCommand}" Background="DarkSeaGreen"/>
        </Grid>
        <Grid Grid.Row="1" Grid.ColumnSpan="4">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0" Width ="200" Text="PLC Connection Status" Foreground="white" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,5,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding PlcStatusColor}" />
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,27,0,0" Width ="200" Text="MES Connection Status" Foreground="white" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,27,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding MesStatusColor}" />
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,49,0,0" Width ="200" Text="UI Connection Status" Foreground="white" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[0]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[1]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[2]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[3]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[4]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[5]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[6]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[7]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="170,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[8]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="190,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[9]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="210,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[10]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,69,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[11]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[12]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[13]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[14]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[15]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[16]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[17]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="130,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[18]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[19]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="170,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[20]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="190,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[21]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="210,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[22]}" />
            <Rectangle HorizontalAlignment="Left" VerticalAlignment="Top" Margin="230,89,0,0" Width="20" Height="20" Stroke="Black" Fill="{Binding UiWebStatusColor[23]}" />
        </Grid>
        <Grid Grid.Row="2" Grid.ColumnSpan="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="0*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0" Width ="200" Text="{Binding InfoMessage}" Foreground="white" Grid.Row="1" Height="16" />
        </Grid>
    </Grid>
</Window>

    
